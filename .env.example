# Copia este archivo como .env.local para trabajar en tu PC.
# NUNCA coloques claves reales en .env.example.

# Analítica
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX

# Verificación opcional por etiqueta HTML en Google Search Console.
# Si verificas la propiedad de dominio por DNS, puedes dejarlo vacío.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Formulario de contacto
RESEND_API_KEY=re_TU_API_KEY_AQUI
CONTACT_TO_EMAIL=drapamiconsultorios@gmail.com

# Mientras drapami.pe no esté verificado en Resend, usa onboarding@resend.dev.
# Después cambia a: Dra. Pami Web <web@drapami.pe>
CONTACT_FROM_EMAIL="Dra. Pami Web <onboarding@resend.dev>"
